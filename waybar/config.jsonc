{
  "position": "top",
  "layer": "top",

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "mpris",
    "hyprland/language",
    "network",
    "memory",
    "battery",
    "pulseaudio",
    "tray",
    "custom/power"
    // "idle_inhibitor"
  ],

  // DEPRECATED USELESS SH**. MAY USE IN THE FUTURE FOR SOME REASON...
  // "hyprland/workspaces": {
  //   "format": "{name} {windows}",
  //   "unique-icons" : true,
  //   "format-window-separator": " ",
  //   "window-rewrite-default": "",
  //
  //   "window-rewrite": {
  //     "class<firefox>": "",
  //     "class<chromium>": "",
  //
  //     "class<spotify>": "",
  //     "class<steam>": "",
  //
  //     "class<Alacritty>": "",
  //     "class<Alacritty> title<.*nvim.*>": "",
  //
  //     "class<thunar>": "",
  //     "class<code>": "󰨞",
  //     "class<org.qt-project.qtcreator>": "",
  //     "class<obsidian>": "󰠮",
  //     "class<org.telegram.desktop>": ""
  //   },
  //
  // },

  "hyprland/workspaces": {
    "format": "{name}",
    "active-only": true,
  },

  "hyprland/window": {
    "format": " <i>{title}</i>",
    "separate-outputs": true,
    "icon": true,
    "icon-size": 28,
  },

  "tray": {
    "icon-size": 20,
    "spacing": 10,
  },

  "battery": {
    "interval": 30,
    "full-at": 80,
    "states": {
      "normal": 70,
      "wtf": 30,
      "critical": 15,
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
    },
    "format": "{icon} {capacity}%",
    // "format-full": "{icon} {capacity}%",
    "format-charging": "{capacity}% ",
    // "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-full": "", // An empty format will hide the module
    "format-icons": ["", "", "", "", ""],
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "format-warning": "  {percentage}%",
    "format-critical": "  {percentage}%",
    "states": {
      "warning": 70,
      "critical": 85
    },
    "tooltip-format": "RAM: {used:0.1f}/{total:0.1f}G ({percentage}%)\nAvailable: {avail:0.1f}G",
    "on-click": "alacritty -e htop"
  },

  "clock": {
    "format": "<i>{:%H:%M %B%e}</i>",
    "format-alt": "{:%Y/%m/%d}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode"          : "month",
      "mode-mon-col"  : 4,
      "weeks-pos"     : "left",
      "iso8601"       : true,
      "format": {
        "months":     "<span color='#e9d8a6'>{}</span>",
        "days":       "<span color='#94d2bd'><b>{}</b></span>",
        "weeks":      "<span color='#0a9396'>{}</span>",
        "weekdays":   "<span color='#005f73'>{}</span>",
        "today":      "<span color='#e0aaff'><u>{}</u></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-middle": "shift_reset"
    }
  },

  "network": {
    "format-wifi": "  {essid} {bandwidthDownBits}",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": " Offline",
    "max-length": 30,
    "on-click": "alacritty -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon} <span style=\"italic\">{volume}%</span>",
    "format-bluetooth": "{icon}  <span style=\"italic\">{volume}%</span>",
    "format-bluetooth-muted": "  {volume}%",
    "format-muted": " {volume}%",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "tooltip": true,
    "tooltip-format": "{desc}",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
  },

  "backlight": {
    "format": "{icon} {percent}% ",
    "format-icons": ["", "󰖨"],
    "tooltip": false,
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} <i>paused</i>  ",
    "player-icons": {
      "default": "",
      "spotify": "",
      "firefox": "",
    },
    "status-icons": {
      "paused": "",
    },
    "max-length": 20,
    // "ignored-players": ["firefox"]
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    // "on-click": "wlogout"
    "on-click": "$HOME/.config/wlogout/logoutlaunch.sh",
  },

  "hyprland/language": {
    "format-en": "en",
    "format-ru": "ru",
    "on-click": "bash -lc 'dev=$(hyprctl -j devices | jq -r \".keyboards[] | select(.main==true).name\" | head -n1); [ -n \"$dev\" ] && hyprctl switchxkblayout \"$dev\" next'",
  },
}
